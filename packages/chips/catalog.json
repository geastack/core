      },
      "configuration": [
        {
          "path": "width",
          "label": "Display width",
          "type": "integer",
          "min": 1,
          "max": 4096
        },
        {
          "path": "height",
          "label": "Display height",
          "type": "integer",
          "min": 1,
          "max": 4096
        },
        {
          "path": "spiHost",
          "label": "SPI host",
          "type": "choice",
          "values": [
            "spi2",
            "spi3"
